#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        holdalt: holdalt {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDALT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <185>;
            quick-tap-ms = <(-1)>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };

        holdbackspace: holdbackspace {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDBACKSPACE";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <66>;
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <31 32>;
        };

        lll {
            bindings = <&kp L>;
            key-positions = <15 19>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        sss {
            bindings = <&kp S>;
            key-positions = <15 16>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        hhh {
            bindings = <&kp H>;
            key-positions = <17 32>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        www {
            bindings = <&kp W>;
            key-positions = <29 30>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        fff {
            bindings = <&kp F>;
            key-positions = <30 17>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        zzz {
            bindings = <&kp Z>;
            key-positions = <31 50>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        rrr {
            bindings = <&kp R>;
            key-positions = <19 16>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        ggg {
            bindings = <&kp G>;
            key-positions = <33 31>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        mmm {
            bindings = <&kp M>;
            key-positions = <33 30>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        nnn {
            bindings = <&kp N>;
            key-positions = <16 17>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        ttt {
            bindings = <&kp T>;
            key-positions = <17 18>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        vvv {
            bindings = <&kp V>;
            key-positions = <33 29>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        ddd {
            bindings = <&kp D>;
            key-positions = <30 31>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };

        ccc {
            bindings = <&kp C>;
            key-positions = <30 32>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <185>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1         &kp N2                 &kp N3            &kp N4               &kp N5  &tog 1                                                                           &mo 3       &kp N6  &kp N7  &kp N8    &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp SQT        &kp COMMA              &kp PERIOD        &kp P                &kp Y   &none                                                                            &none       &kp F   &kp G   &kp C     &kp R     &kp L     &kp BSLH
&kp ESC    &kp A          &holdalt LEFT_SHIFT O  &holdalt LCTRL E  &holdalt LEFT_ALT U  &kp I   &kp KP_DOT  &kp LCTRL                   &kp LALT      &kp LGUI   &kp RCTRL       &none       &kp D   &kp H   &kp T     &kp N     &kp S     &kp MINUS
&kp LSHFT  &kp SEMICOLON  &kp Q                  &kp J             &kp K                &kp X                                           &kp HOME      &kp PG_UP                              &kp B   &kp M   &kp W     &kp V     &kp Z     &kp EQUAL
&mo 2      &kp GRAVE      &kp CAPS               &kp LEFT          &kp RIGHT                    &kp SPACE   &holdbackspace 4 BACKSPACE  &kp END       &kp PG_DN  &kp LEFT_ARROW  &kp DELETE          &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &kp B         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        layer_8 {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0                  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3     &bt BT_SEL 4      &none                                                    &trans           &none  &none       &none       &none  &none  &none
&none           &none                         &kp LC(Z)     &kp LS(LC(Z))  &kp LC(KP_PLUS)  &kp LC(KP_MINUS)  &kp LG(LS(S))                                            &none            &none  &none       &none       &none  &none  &none
&none           &holdalt LEFT_SHIFT NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4     &kp NUMBER_5      &none          &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&kp LEFT_SHIFT  &kp NUMBER_6                  &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9     &kp NUMBER_0                            &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none                         &kp LS(D)     &kp LC(C)      &kp LC(V)                          &none          &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
